APP_ENV=development
DATABASE_URL=sqlite+aiosqlite:///./mergen.db
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL_FAST=gemini-3.5-flash-lite
LLM_MODEL_STRONG=gemini-3.5-flash-lite
LLM_TIMEOUT_SECONDS=120
LLM_PROJECT_ANALYSIS_TIMEOUT_SECONDS=35
LLM_RETRIES=0
LLM_MAX_OUTPUT_TOKENS_FAST=2500
LLM_MAX_OUTPUT_TOKENS_STRONG=7000
CORS_ORIGINS=http://localhost:5173
DEMO_MODE=true
# Fixture yalnızca açıkça etkinleştirilirse kullanılır; gerçek AI değildir.
DEMO_FIXTURES=false

LLM_MODEL_PROJECT_ANALYSIS=gemini-3.5-flash-lite
