  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "mergen/v1",
      "default": "mergen/v1",
      "title": "Schemaversion",
      "type": "string"
    },
    "project": {
      "$ref": "#/$defs/ProjectView"
    },
    "learnerProfile": {
      "$ref": "#/$defs/LearnerProfile"
    },
    "discovery": {
      "$ref": "#/$defs/DiscoveryView"
    },
    "maps": {
