{
  "$defs": {
    "AssessmentQuestion": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "prompt": {
          "minLength": 1,
          "title": "Prompt",
          "type": "string"
        },
        "options": {
          "items": {
            "type": "string"
          },
          "maxItems": 6,
          "minItems": 2,
          "title": "Options",
          "type": "array"
        },
        "correctIndex": {
          "minimum": 0,
          "title": "Correctindex",
          "type": "integer"
        },
        "explanation": {
          "title": "Explanation",
          "type": "string"
        },
        "targetSkill": {
          "title": "Targetskill",
          "type": "string"
        },
        "difficulty": {
          "title": "Difficulty",
          "type": "string"
        }
      },
      "required": [
        "id",
        "prompt",
        "options",
        "correctIndex",
        "explanation",
        "targetSkill",
        "difficulty"
      ],
      "title": "AssessmentQuestion",
      "type": "object"
    },
    "AssessmentView": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "nodeId": {
          "title": "Nodeid",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "passingScore": {
          "title": "Passingscore",
          "type": "number"
        },
        "version": {
          "title": "Version",
          "type": "integer"
        },
        "questions": {
          "items": {
            "$ref": "#/$defs/PublicQuestion"
          },
          "title": "Questions",
          "type": "array"
        }
      },
      "required": [
        "id",
        "nodeId",
        "title",
        "passingScore",
        "version",
        "questions"
      ],
      "title": "AssessmentView",
      "type": "object"
    },
    "DemoAssessmentView": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "nodeId": {
          "title": "Nodeid",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "passingScore": {
          "title": "Passingscore",
          "type": "number"
        },
        "version": {
          "title": "Version",
          "type": "integer"
        },
        "questions": {
          "items": {
            "$ref": "#/$defs/AssessmentQuestion"
          },
          "title": "Questions",
          "type": "array"
        }
      },
      "required": [
        "id",
        "nodeId",
        "title",
        "passingScore",
        "version",
        "questions"
      ],
      "title": "DemoAssessmentView",
      "type": "object"
    },
    "DiscoveryAnswer": {
      "additionalProperties": false,
      "properties": {
        "questionId": {
          "title": "Questionid",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "questionId",
        "value"
      ],
      "title": "DiscoveryAnswer",
      "type": "object"
    },
    "DiscoveryQuestion": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "questionId": {
          "title": "Questionid",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "section": {
          "default": "advisor",
          "enum": [
            "advisor",
            "project"
          ],
          "title": "Section",
          "type": "string"
        },
        "type": {
          "enum": [
            "single_choice",
            "multi_choice",
            "short_text"
          ],
          "title": "Type",
          "type": "string"
        },
        "options": {
          "items": {
            "type": "string"
          },
          "title": "Options",
          "type": "array"
        },
        "targetField": {
          "title": "Targetfield",
          "type": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "parentQuestionId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parentquestionid"
        },
        "completed": {
          "default": false,
          "title": "Completed",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "questionId",
        "text",
        "type",
        "targetField"
      ],
      "title": "DiscoveryQuestion",
      "type": "object"
    },
    "DiscoveryView": {
      "additionalProperties": false,
      "properties": {
        "questions": {
          "items": {
            "$ref": "#/$defs/DiscoveryQuestion"
          },
          "title": "Questions",
          "type": "array"
        },
        "answers": {
          "items": {
            "$ref": "#/$defs/DiscoveryAnswer"
          },
          "title": "Answers",
          "type": "array"
        },
        "completed": {
          "title": "Completed",
          "type": "boolean"
        },
        "nextQuestion": {
          "anyOf": [
            {
              "$ref": "#/$defs/DiscoveryQuestion"
            },
            {
              "type": "null"
            }
          ]
        },
        "readyForRoadmap": {
          "title": "Readyforroadmap",
          "type": "boolean"
        }
      },
      "required": [
        "questions",
        "answers",
        "completed",
        "nextQuestion",
        "readyForRoadmap"
      ],
      "title": "DiscoveryView",
      "type": "object"
    },
    "EdgeView": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "target": {
          "title": "Target",
          "type": "string"
        },
        "kind": {
          "enum": [
            "requires",
            "supports"
          ],
          "title": "Kind",
          "type": "string"
