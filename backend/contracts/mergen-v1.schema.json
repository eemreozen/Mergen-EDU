        "$ref": "#/$defs/MapView"
      },
      "title": "Maps",
      "type": "array"
    },
    "assessments": {
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/AssessmentView"
          },
          {
            "$ref": "#/$defs/DemoAssessmentView"
          }
        ]
      },
      "title": "Assessments",
      "type": "array"
    },
    "resources": {
