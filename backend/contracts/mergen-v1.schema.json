        "targetNodeId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Targetnodeid"
        },
        "weakSkills": {
          "items": {
            "type": "string"
          },
          "title": "Weakskills",
          "type": "array"
        },
        "generationStatus": {
          "title": "Generationstatus",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "integer"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/NodeView"
          },
          "title": "Nodes",
          "type": "array"
        },
        "edges": {
          "items": {
            "$ref": "#/$defs/EdgeView"
          },
          "title": "Edges",
          "type": "array"
        },
        "metadata": {
          "$ref": "#/$defs/Metadata"
        }
