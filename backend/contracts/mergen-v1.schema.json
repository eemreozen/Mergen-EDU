      "required": [
        "id",
        "projectId",
        "title",
        "description",
        "parentMapId",
        "parentNodeId",
        "generationStatus",
        "version",
        "nodes",
        "edges",
        "metadata"
      ],
      "title": "MapView",
      "type": "object"
