        "verifiedSkills": {
          "items": {
            "type": "string"
          },
          "title": "Verifiedskills",
          "type": "array"
        },
        "weeklyHours": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Weeklyhours"
        }
      },
      "title": "LearnerProfile",
      "type": "object"
    },
    "MapView": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "projectId": {
          "title": "Projectid",
          "type": "string"
